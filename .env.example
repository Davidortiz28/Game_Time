# Copy to .env and fill both passwords locally. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5433/gametime
DB_USER=gametime_app
DB_PASSWORD=
DB_ADMIN_USER=gametime_admin
DB_ADMIN_PASSWORD=
# Token que comparten el backend y el cliente JavaFX del jugador (mínimo 32 caracteres).
# Genera uno aleatorio, por ejemplo con: openssl rand -hex 32
CLIENT_API_TOKEN=
